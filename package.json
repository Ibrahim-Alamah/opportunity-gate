{
  "name": "opportunity-gate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Opportunity Gate (بوّابة الفرص) - Bilingual platform for verified scholarships, free courses, and internships for Yemeni students.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-data.ts",
    "test:data": "node scripts/validate-data.ts --self-test",
    "monitor:data": "node scripts/monitor-opportunities.ts",
    "test:functional": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.4.6"
  }
}

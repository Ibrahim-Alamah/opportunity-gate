{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opportunity-gate.local/schemas/opportunities.schema.json",
  "title": "Opportunity Gate Dataset Schema",
  "description": "JSON Schema (Draft 2020-12) for verified scholarships, free courses, and internships in Opportunity Gate (بوّابة الفرص).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "lastUpdated",
    "opportunities"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Fixed schema version identifier."
    },
    "lastUpdated": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "description": "Calendar date (YYYY-MM-DD) when the dataset was last updated."
    },
    "opportunities": {
      "type": "array",
      "description": "List of verified opportunity records.",
      "items": {
        "$ref": "#/$defs/Opportunity"
      }
    }
  },
  "$defs": {
    "NonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "LocalizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ar",
        "en"
      ],
      "properties": {
        "ar": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "en": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "LocalizedStringList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ar",
        "en"
      ],
      "properties": {
        "ar": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        },
        "en": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/NonEmptyString"
          }
        }
      }
    },
    "Iso3166Alpha2Code": {
      "type": "string",
      "description": "Official ISO 3166-1 alpha-2 two-letter country code (249 codes).",
      "enum": [
        "AD", "AE", "AF", "AG", "AI", "AL", "AM", "AO", "AQ", "AR", "AS", "AT", "AU", "AW", "AX", "AZ",
        "BA", "BB", "BD", "BE", "BF", "BG", "BH", "BI", "BJ", "BL", "BM", "BN", "BO", "BQ", "BR", "BS", "BT", "BV", "BW", "BY", "BZ",
        "CA", "CC", "CD", "CF", "CG", "CH", "CI", "CK", "CL", "CM", "CN", "CO", "CR", "CU", "CV", "CW", "CX", "CY", "CZ",
        "DE", "DJ", "DK", "DM", "DO", "DZ",
        "EC", "EE", "EG", "EH", "ER", "ES", "ET",
        "FI", "FJ", "FK", "FM", "FO", "FR",
        "GA", "GB", "GD", "GE", "GF", "GG", "GH", "GI", "GL", "GM", "GN", "GP", "GQ", "GR", "GS", "GT", "GU", "GW", "GY",
        "HK", "HM", "HN", "HR", "HT", "HU",
        "ID", "IE", "IL", "IM", "IN", "IO", "IQ", "IR", "IS", "IT",
        "JE", "JM", "JO", "JP",
        "KE", "KG", "KH", "KI", "KM", "KN", "KP", "KR", "KW", "KY", "KZ",
        "LA", "LB", "LC", "LI", "LK", "LR", "LS", "LT", "LU", "LV", "LY",
        "MA", "MC", "MD", "ME", "MF", "MG", "MH", "MK", "ML", "MM", "MN", "MO", "MP", "MQ", "MR", "MS", "MT", "MU", "MV", "MW", "MX", "MY", "MZ",
        "NA", "NC", "NE", "NF", "NG", "NI", "NL", "NO", "NP", "NR", "NU", "NZ",
        "OM",
        "PA", "PE", "PF", "PG", "PH", "PK", "PL", "PM", "PN", "PR", "PS", "PT", "PW", "PY",
        "QA",
        "RE", "RO", "RS", "RU", "RW",
        "SA", "SB", "SC", "SD", "SE", "SG", "SH", "SI", "SJ", "SK", "SL", "SM", "SN", "SO", "SR", "SS", "ST", "SV", "SX", "SY", "SZ",
        "TC", "TD", "TF", "TG", "TH", "TJ", "TK", "TL", "TM", "TN", "TO", "TR", "TT", "TV", "TW", "TZ",
        "UA", "UG", "UM", "US", "UY", "UZ",
        "VA", "VC", "VE", "VG", "VI", "VN", "VU",
        "WF", "WS",
        "YE", "YT",
        "ZA", "ZM", "ZW"
      ]
    },
    "CountryScopeCode": {
      "oneOf": [
        {
          "$ref": "#/$defs/Iso3166Alpha2Code"
        },
        {
          "type": "string",
          "enum": [
            "MULTI",
            "GLOBAL"
          ]
        }
      ]
    },
    "CountryInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "ar",
        "en"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/CountryScopeCode"
        },
        "ar": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "en": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "SpecificFieldOfStudyTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ar",
        "en"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!all-fields$|unspecified$)[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "ar": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "en": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "SpecialFieldOfStudyTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ar",
        "en"
      ],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "all-fields",
            "unspecified"
          ]
        },
        "ar": {
          "$ref": "#/$defs/NonEmptyString"
        },
        "en": {
          "$ref": "#/$defs/NonEmptyString"
        }
      }
    },
    "SpecificStudyLevel": {
      "type": "string",
      "enum": [
        "high_school",
        "undergraduate",
        "graduate",
        "recent_graduate"
      ]
    },
    "SpecialStudyLevel": {
      "type": "string",
      "enum": [
        "all",
        "unspecified"
      ]
    },
    "Opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "provider",
        "country",
        "mode",
        "fieldsOfStudy",
        "studyLevels",
        "deadlineType",
        "deadline",
        "officialUrl",
        "verifiedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?!example-|mock-|dummy-|sample-demo-)[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "Unique kebab-case identifier. Must not start with reserved mock/demo prefixes."
        },
        "category": {
          "type": "string",
          "enum": [
            "scholarship",
            "course",
            "internship"
          ]
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "provider": {
          "$ref": "#/$defs/LocalizedText"
        },
        "country": {
          "$ref": "#/$defs/CountryInfo"
        },
        "availableCountries": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Iso3166Alpha2Code"
          },
          "description": "Optional list of ISO 3166-1 alpha-2 country codes when country.code is MULTI and the official source lists the eligible host countries."
        },
        "mode": {
          "type": "string",
          "enum": [
            "onsite",
            "online",
            "hybrid"
          ]
        },
        "fieldsOfStudy": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/SpecificFieldOfStudyTag"
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/SpecialFieldOfStudyTag"
              }
            }
          ]
        },
        "studyLevels": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/SpecificStudyLevel"
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/SpecialStudyLevel"
              }
            }
          ]
        },
        "deadlineType": {
          "type": "string",
          "enum": [
            "fixed",
            "rolling",
            "unspecified"
          ]
        },
        "deadline": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "officialUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[^\\s/$.?#].[^\\s]*$"
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
        },
        "fundingType": {
          "type": "string",
          "enum": [
            "fully_funded",
            "partially_funded",
            "free",
            "paid"
          ]
        },
        "description": {
          "$ref": "#/$defs/LocalizedText"
        },
        "eligibility": {
          "$ref": "#/$defs/LocalizedStringList"
        },
        "benefits": {
          "$ref": "#/$defs/LocalizedStringList"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "deadlineType": {
                "const": "fixed"
              }
            }
          },
          "then": {
            "properties": {
              "deadline": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "deadline": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "country": {
                  "properties": {
                    "code": {
                      "const": "MULTI"
                    }
                  }
                }
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "availableCountries"
              ]
            }
          }
        }
      ]
    }
  }
}

